---
import CaseGrid from '../components/CaseGrid.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('meta.home.title')} description={t('meta.home.description')}>
  <Hero lang={lang} />
  <Section id="projects" title={t('caseStudies.title')} subtitle={t('caseStudies.subtitle')}>
    <CaseGrid lang={lang} />
  </Section>
  <Section id="engineering" title={t('engineering.title')} subtitle={t('engineering.subtitle')} />
  <Section id="stack" title={t('stack.title')} />
  <Section id="contact" title={t('contact.title')} />
</BaseLayout>
