---
import { getRelativeLocaleUrl } from 'astro:i18n';
import CaseFigure from '../components/CaseFigure.astro';
import InlineText from '../components/InlineText.astro';
import Metric from '../components/Metric.astro';
import Todo from '../components/Todo.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { caseStudies, type CaseStudy } from '../lib/case-studies';

interface Props {
  entry: CaseStudy;
  lang: Locale;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { title, tag, intro, context, solution, result } = entry.data;
const { Content, headings } = await entry.render();
const toc = headings.filter((h) => h.depth === 2);

const all = caseStudies(lang);
const index = all.findIndex((e) => e.caseSlug === entry.caseSlug);
const overview = [
  { label: t('caseStudies.labels.context'), text: context, callout: false },
  { label: t('caseStudies.labels.solution'), text: solution, callout: false },
  { label: t('caseStudies.labels.result'), text: result, callout: true },
];
// Next always sits in the right column, even on the first case.
const neighbors = [
  { entry: all[index - 1], label: t('caseStudy.prev'), class: '' },
  { entry: all[index + 1], label: t('caseStudy.next'), class: 'sm:col-start-2 sm:text-right' },
].filter((n): n is typeof n & { entry: CaseStudy } => n.entry !== undefined);
const caseUrl = (e: CaseStudy) => getRelativeLocaleUrl(lang, `case-studies/${e.caseSlug}`);
---

<BaseLayout lang={lang} title={`${title} — Tri Huu Nguyen`} description={context}>
  <article>
    <!-- Header and overview use the full page width; the deep dive below reads in one column. -->
    <header class="dark-band">
      <div class="container-page pb-10 pt-8 sm:pt-12 lg:pb-14 lg:pt-14">
        <a href={`${getRelativeLocaleUrl(lang)}#projects`} class="link text-sm">
          <span aria-hidden="true">← </span>{t('caseStudy.back')}
        </a>

        <div class="mt-8 max-w-3xl">
          <span class="tag">{tag}</span>
          <h1
            class="font-heading mt-4 text-[clamp(2.25rem,5vw,3.5rem)] font-bold leading-tight tracking-tight text-white"
          >
            {title}
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-slate-300 sm:text-xl sm:!text-left">
            <InlineText text={intro} />
          </p>
        </div>

        <section aria-labelledby="overview-title" class="mt-10 lg:mt-12">
          <h2 id="overview-title" class="eyebrow">{t('caseStudy.overview')}</h2>
          <dl class="mt-4 grid gap-4 md:grid-cols-3 lg:gap-6">
            {
              overview.map(({ label, text, callout }) => (
                <div
                  class:list={[
                    'card !p-5 sm:!p-6',
                    { 'border-[#6366f1]/40 bg-[#6366f1]/[0.08]': callout },
                  ]}
                >
                  <dt class="font-mono text-[11px] uppercase tracking-wider text-[#818cf8]">
                    {label}
                  </dt>
                  <dd class="mt-2 leading-relaxed text-slate-200 sm:!text-left">
                    <InlineText text={text} />
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>
      </div>
    </header>

    <div class="container-page pb-12 lg:pb-16">
      <div class="flex items-center gap-4" role="separator" aria-label={t('caseStudy.deepDive')}>
        <span class="h-px flex-1 bg-white/10"></span>
        <span class="font-mono text-xs uppercase tracking-wider text-[#818cf8]" aria-hidden="true"
          >{t('caseStudy.deepDive')}</span
        >
        <span class="h-px flex-1 bg-white/10"></span>
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-12">
        {
          toc.length > 0 && (
            <nav aria-labelledby="toc-title" class="hidden lg:col-span-3 lg:block">
              <div class="sticky top-24">
                <p id="toc-title" class="eyebrow">
                  {t('caseStudy.onThisPage')}
                </p>
                <ul class="mt-4 space-y-1 border-l border-white/10">
                  {toc.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class="-ml-px block border-l border-transparent py-1.5 pl-4 text-sm text-slate-400 transition-colors hover:border-[#818cf8] hover:text-white"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </nav>
          )
        }

        <div class="min-w-0 lg:col-span-9">
          <div class="prose-case">
            <Content components={{ Diagram: CaseFigure, Metric, Todo }} />
          </div>
        </div>
      </div>

      <nav aria-label={t('caseStudy.navLabel')} class="mt-16 border-t border-white/10 pt-8">
        <ul class="grid gap-4 sm:grid-cols-2 lg:gap-6">
          {
            neighbors.map((n) => (
              <li class={n.class}>
                <a href={caseUrl(n.entry)} class="card card-hover block">
                  <span class="block font-mono text-[11px] uppercase tracking-wider text-[#818cf8]">
                    {n.label}
                  </span>
                  <span class="font-heading mt-2 block text-lg font-semibold text-white">
                    {n.entry.data.title}
                  </span>
                  <span class="mt-1 block text-sm text-slate-400">{n.entry.data.tag}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </article>
</BaseLayout>
