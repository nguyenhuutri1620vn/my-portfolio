---
import { site } from '../data/site';
import type { Locale } from '../i18n/config';
import ProfileCard from './ProfileCard.astro';

// Shared hero layout for home and /for-clients: profile on the left; on the right the
// headline, the page's intro (slot "intro"), the tech chips, then the page's CTAs (default slot).
interface Props {
  lang: Locale;
  id: string;
  title: string;
}

const { lang, id, title } = Astro.props;
---

<div class="dark-band relative overflow-hidden">
  <section aria-labelledby={id} class="container-page pb-12 pt-8 sm:pt-12 lg:pb-16 lg:pt-14">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <ProfileCard lang={lang} />

      <div class="flex flex-col justify-center lg:col-span-7">
        <span aria-hidden="true" class="h-1 w-12 rounded-full bg-white/90"></span>

        <h1
          id={id}
          class="font-heading mt-6 text-[clamp(2rem,4vw,3rem)] font-bold leading-tight tracking-tight text-white"
        >
          {title}
        </h1>

        <slot name="intro" />

        <ul class="mt-6 flex flex-wrap gap-2">
          {
            site.heroChips.map((chip) => (
              <li>
                <span class="tag">{chip}</span>
              </li>
            ))
          }
        </ul>

        <slot />
      </div>
    </div>
  </section>
</div>
