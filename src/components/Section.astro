---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="container-page section">
  <h2 id={`${id}-title`}>{title}</h2>
  {subtitle && <p class="mt-3 max-w-prose">{subtitle}</p>}
  <slot />
</section>
