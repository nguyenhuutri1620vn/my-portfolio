---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  // Full-width dark band behind the section (DESIGN "Dark band").
  dark?: boolean;
}

const { id, title, subtitle, dark = false } = Astro.props;
---

<div class:list={{ 'dark-band': dark }}>
  <section id={id} aria-labelledby={`${id}-title`} class="container-page section relative">
    <div class="mb-4 flex items-center gap-2">
      <span class="h-1.5 w-1.5 rounded-[1px] bg-[#6366f1] shadow-[0_0_8px_#6366f1]"></span>
      <span class="h-px w-12 bg-gradient-to-r from-[#6366f1]/60 to-transparent"></span>
    </div>
    <h2
      id={`${id}-title`}
      class="max-w-3xl font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight"
    >
      {title}
    </h2>
    {subtitle && <p class="mt-4 max-w-prose text-[1.0625rem] text-slate-300">{subtitle}</p>}
    <slot />
  </section>
</div>
