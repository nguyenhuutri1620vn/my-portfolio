---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site } from '../data/site';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { resumeHref } from '../lib/resume';
import HeroShell from './HeroShell.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const resume = resumeHref(lang);
---

<HeroShell lang={lang} id="hero-title" title={t('hero.vision')}>
  <p slot="intro" class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-slate-300">
    {t('hero.positioning')}
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-4">
    <a href="#projects" class="btn-primary">{t('hero.viewCaseStudies')}</a>
    {
      resume && (
        <a href={resume} class="btn-light">
          {t('hero.downloadResume')}
        </a>
      )
    }
    <a href={site.github} target="_blank" rel="noopener noreferrer" class="link text-sm">
      {t('hero.github')}<span class="sr-only"> {t('a11y.newTab')}</span>
    </a>
  </div>

  <p class="mt-6 text-sm">
    <a href={getRelativeLocaleUrl(lang, 'for-clients')} class="link">
      {t('hero.forClientsLink')}
    </a>
  </p>
</HeroShell>
