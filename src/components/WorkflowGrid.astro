---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { n: '01' },
  { n: '02' },
  { n: '03' },
  { n: '04' },
  { n: '05', tag: t('workflow.steps.05.tag') },
  { n: '06', tag: t('workflow.steps.06.tag') },
] as const;
---

<!-- Each card spans three subgrid rows (number + tag, title, text) so rows line up. -->
<ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    steps.map((step) => (
      <li class="card row-span-3 grid grid-rows-subgrid gap-y-0">
        <div class="flex items-center justify-between gap-3">
          <span class="font-heading text-sm font-semibold text-[#818cf8]">{step.n}</span>
          {'tag' in step && <span class="tag">{step.tag}</span>}
        </div>
        <h3 class="mt-3 text-xl">{t(`workflow.steps.${step.n}.title`)}</h3>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-slate-300">
          {t(`workflow.steps.${step.n}.text`)}
        </p>
      </li>
    ))
  }
</ol>
