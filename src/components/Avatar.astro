---
import { site } from '../data/site';
import { inPublic } from '../lib/public-file';

interface Props {
  alt: string;
  // Edge length in px for circle avatar mode
  size?: number;
}

const { alt, size = 80 } = Astro.props;
const hasPhoto = inPublic(site.avatar);
const initials = site.name
  .split(' ')
  .filter((_, i, all) => i === 0 || i === all.length - 1)
  .map((word) => word[0])
  .join('');
---

{
  hasPhoto ? (
    <img
      src={site.avatar}
      alt={alt}
      width={size}
      height={size}
      style={{ width: `${size}px`, height: `${size}px` }}
      class="max-w-full rounded-full border border-white/15 object-cover shadow-[0_0_40px_-8px_rgba(99,102,241,0.45)]"
    />
  ) : (
    <span
      role="img"
      aria-label={alt}
      style={{ width: `${size}px`, height: `${size}px` }}
      class="font-heading flex items-center justify-center rounded-full bg-slate-800 text-4xl text-white border border-white/10 shadow-[0_0_40px_-8px_rgba(99,102,241,0.3)]"
    >
      <span aria-hidden="true">{initials}</span>
    </span>
  )
}
