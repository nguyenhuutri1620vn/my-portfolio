---
import { Image } from 'astro:assets';
import { isLocale } from '../i18n/config';
import { caseStudies } from '../lib/case-studies';
import Diagram from './diagrams/Diagram.astro';
import type { DiagramName } from './diagrams/index';

// Rendered by `<Diagram />` inside case-study MDX: the case is resolved from the page route
// (/{lang}/case-studies/{slug}). With no `name` it shows the case's architecture diagram and
// optional UI image; `<Diagram name="..." />` shows just that extra diagram.
interface Props {
  name?: DiagramName;
}

const { name } = Astro.props;
const lang = Astro.currentLocale;
const slug = Astro.params.slug;
const entry = isLocale(lang) ? caseStudies(lang).find((e) => e.caseSlug === slug) : undefined;
if (!entry || !isLocale(lang)) {
  throw new Error(`CaseFigure: no case study for ${Astro.url.pathname}`);
}
const { diagram, image } = entry.data;
---

<figure class="card my-8 p-4">
  <Diagram name={name ?? diagram} lang={lang} />
</figure>
{
  !name && image && (
    <figure class="card my-8 p-2">
      <Image src={image.src} alt={image.alt} class="h-auto w-full rounded-btn" />
    </figure>
  )
}
