---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { projectMailto } from '../lib/mailto';
import HeroShell from './HeroShell.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<HeroShell lang={lang} id="client-hero-title" title={t('forClients.hero.vision')}>
  <Fragment slot="intro">
    <p class="font-heading mt-4 text-lg text-[#a5b4fc] sm:text-xl">
      {t('forClients.hero.title')}
    </p>
    <p class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-slate-300">
      {t('forClients.hero.intro')}
    </p>
  </Fragment>

  <div class="mt-8 flex flex-wrap items-center gap-4">
    <a href={projectMailto(lang)} class="btn-primary">{t('forClients.startProject')}</a>
    <a href={`${getRelativeLocaleUrl(lang)}#projects`} class="btn-light">
      {t('forClients.hero.seeCaseStudies')}
    </a>
  </div>
</HeroShell>
