---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site } from '../data/site';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { projectMailto } from '../lib/mailto';
import ProfileCard from './ProfileCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Same layout as the home Hero: profile on the left; vision, intro, chips, CTAs on the right. -->
<div class="dark-band relative overflow-hidden">
  <section
    aria-labelledby="client-hero-title"
    class="container-page pb-12 pt-8 sm:pt-12 lg:pb-16 lg:pt-14"
  >
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <ProfileCard lang={lang} />

      <div class="flex flex-col justify-center lg:col-span-7">
        <span aria-hidden="true" class="h-1 w-12 rounded-full bg-white/90"></span>

        <h1
          id="client-hero-title"
          class="font-heading mt-6 text-[clamp(2rem,4vw,3rem)] font-bold leading-tight tracking-tight text-white"
        >
          {t('forClients.hero.vision')}
        </h1>
        <p class="font-heading mt-4 text-lg text-[#a5b4fc] sm:text-xl">
          {t('forClients.hero.title')}
        </p>

        <p class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-slate-300">
          {t('forClients.hero.intro')}
        </p>

        <ul class="mt-6 flex flex-wrap gap-2">
          {
            site.heroChips.map((chip) => (
              <li>
                <span class="tag">{chip}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={projectMailto(lang)} class="btn-primary">{t('forClients.startProject')}</a>
          <a href={`${getRelativeLocaleUrl(lang)}#projects`} class="btn-light">
            {t('forClients.hero.seeCaseStudies')}
          </a>
        </div>
      </div>
    </div>
  </section>
</div>
