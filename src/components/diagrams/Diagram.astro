---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { diagrams, type DiagramName } from './index';

interface Props {
  name: DiagramName;
  lang: Locale;
  // Card thumbnails repeat the card text, so screen readers skip them.
  decorative?: boolean;
}

const { name, lang, decorative = false } = Astro.props;
const t = useTranslations(lang);
const Body = diagrams[name];
const id = `dg-${name}${decorative ? '-thumb' : ''}`;
---

<svg
  class="dg block h-auto w-full"
  viewBox="0 0 640 360"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-labelledby={decorative ? undefined : `${id}-title`}
  aria-describedby={decorative ? undefined : `${id}-desc`}
  focusable="false"
>
  <title id={`${id}-title`}>{t(`diagrams.${name}.title`)}</title>
  <desc id={`${id}-desc`}>{t(`diagrams.${name}.desc`)}</desc>
  <defs>
    <marker
      id={`${id}-arrow`}
      viewBox="0 0 8 8"
      refX="7"
      refY="4"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path class="dg-head" d="M0,0 L8,4 L0,8 z"></path>
    </marker>
  </defs>
  <Body lang={lang} marker={`${id}-arrow`} />
</svg>
