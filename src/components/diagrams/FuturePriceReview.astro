---
import type { Locale } from '../../i18n/config';
import Arrow from './parts/Arrow.astro';
import Box from './parts/Box.astro';
import { diagramLabels } from './parts/labels';

interface Props {
  lang: Locale;
  marker: string;
}

const { lang, marker } = Astro.props;
const l = diagramLabels(lang, 'future-price-review');

// Review flow on the top row; the approved price lands on the bottom right.
const col = [8, 139, 270, 401, 532];
const top = 90;
const bottom = 216;
const w = 100;
const h = 54;
---

<Box x={col[0]} y={top} w={w} h={h} label={l('future')} sub={l('futureSub')} store />
<Box x={col[1]} y={top} w={w} h={h} label={l('compare')} sub={l('compareSub')} />
<Box x={col[2]} y={top} w={w} h={h} label={l('grid')} sub={l('gridSub')} focus />
<Box x={col[3]} y={top} w={w} h={h} label={l('decide')} sub={l('decideSub')} />
<Box x={col[4]} y={top} w={w} h={h} label={l('job')} sub={l('jobSub')} />
<Box x={col[4]} y={bottom} w={w} h={h} label={l('rules')} sub={l('rulesSub')} />
<Box x={col[3]} y={bottom} w={w} h={h} label={l('active')} sub={l('activeSub')} store stack />

<Arrow
  marker={marker}
  points={[
    [108, 117],
    [138, 117],
  ]}
/>
<Arrow
  marker={marker}
  points={[
    [239, 117],
    [269, 117],
  ]}
/>
<Arrow
  marker={marker}
  points={[
    [370, 117],
    [400, 117],
  ]}
/>
<Arrow
  marker={marker}
  points={[
    [501, 117],
    [531, 117],
  ]}
/>
