---
import type { Locale } from '../../i18n/config';
import Arrow from './parts/Arrow.astro';
import Box from './parts/Box.astro';
import { diagramLabels } from './parts/labels';

interface Props {
  lang: Locale;
  marker: string;
}

const { lang, marker } = Astro.props;
const l = diagramLabels(lang, 'insight-dashboard');

const col = [8, 176, 344, 512];
const y = 146;
const w = 120;
const h = 68;
---

<Box x={col[0]} y={y} w={w} h={h} label={l('source')} sub={l('sourceSub')} store />
<Box x={col[1]} y={y} w={w} h={h} label={l('search')} sub={l('searchSub')} store focus />
<Box x={col[2]} y={y} w={w} h={h} label={l('api')} sub={l('apiSub')} />
<Box x={col[3]} y={y} w={w} h={h} label={l('dashboard')} sub={l('dashboardSub')} />

<Arrow
  marker={marker}
  points={[
    [128, 180],
    [175, 180],
  ]}
  label={l('sync')}
  labelAt={[152, 170]}
/>
<Arrow
  marker={marker}
  points={[
    [296, 180],
    [343, 180],
  ]}
/>
<Arrow
  marker={marker}
  points={[
    [464, 180],
    [511, 180],
  ]}
/>
