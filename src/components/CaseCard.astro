---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import type { CaseStudy } from '../lib/case-studies';
import Diagram from './diagrams/Diagram.astro';
import InlineText from './InlineText.astro';

interface Props {
  entry: CaseStudy;
  lang: Locale;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { title, tag, context, solution, result, diagram } = entry.data;
const rows = [
  { label: t('caseStudies.labels.context'), text: context },
  { label: t('caseStudies.labels.solution'), text: solution },
  { label: t('caseStudies.labels.result'), text: result },
];
---

<article class="card flex h-full flex-col">
  <span class="tag self-start">{tag}</span>
  <h3 class="mt-3">{title}</h3>
  <div class="mt-4 aspect-video overflow-hidden rounded-btn bg-surface/40 p-2">
    <Diagram name={diagram} lang={lang} decorative />
  </div>
  <dl class="mb-6 mt-4 space-y-3 text-sm">
    {
      rows.map(({ label, text }) => (
        <div>
          <dt class="font-mono text-[11px] uppercase tracking-wider text-brown">{label}</dt>
          <dd class="mt-0.5">
            <InlineText text={text} />
          </dd>
        </div>
      ))
    }
  </dl>
  <a
    href={getRelativeLocaleUrl(lang, `case-studies/${entry.caseSlug}`)}
    class="btn-secondary mt-auto self-start"
    aria-label={`${t('caseStudies.viewDetails')}: ${title}`}
  >
    {t('caseStudies.viewDetails')}
  </a>
</article>
