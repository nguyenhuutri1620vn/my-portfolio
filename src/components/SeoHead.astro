---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { defaultLocale, locales, pathWithoutLocale, type Locale } from '../i18n/config';
import Favicons from './Favicons.astro';

interface Props {
  lang: Locale;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;

const path = pathWithoutLocale(Astro.url.pathname, lang);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={getAbsoluteLocaleUrl(lang, path)} />
{locales.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l, path)} />)}
<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, path)} />
<Favicons />
