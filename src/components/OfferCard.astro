---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Locale;
  n: string;
  title: string;
  text: string;
  // Case study that shows this offer in production.
  caseSlug: string;
}

const { lang, n, title, text, caseSlug } = Astro.props;
const t = useTranslations(lang);
---

<!-- Four rows on the parent's subgrid (number, title, text, link), like CaseCard. -->
<article class="card card-hover row-span-4 grid grid-rows-subgrid gap-y-0">
  <span class="font-heading text-sm font-semibold text-[#818cf8]">{n}</span>
  <h3 class="mt-2 text-xl">{title}</h3>
  <p class="mt-3 text-[0.95rem] leading-relaxed text-slate-300">{text}</p>
  <a
    href={getRelativeLocaleUrl(lang, `case-studies/${caseSlug}`)}
    class="link-arrow mt-6 self-end justify-self-start"
    aria-label={`${t('forClients.offers.seeCase')}: ${title}`}
  >
    {t('forClients.offers.seeCase')}
    <span aria-hidden="true">→</span>
  </a>
</article>
