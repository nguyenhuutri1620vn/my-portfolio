---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { caseStudies } from '../lib/case-studies';
import CaseCard from './CaseCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const entries = caseStudies(lang);
// Key projects first in large cards (2 x 2), then the rest in smaller cards.
const groups = [
  { title: t('caseStudies.keyTitle'), featured: true },
  { title: t('caseStudies.moreTitle'), featured: false },
]
  .map((g) => ({ ...g, entries: entries.filter((e) => e.data.featured === g.featured) }))
  .filter((g) => g.entries.length > 0);
---

{
  groups.map(({ title, featured, entries }) => (
    <>
      <h3 class:list={['eyebrow', featured ? 'mt-10' : 'mt-14']}>{title}</h3>
      <ul class:list={['mt-5 grid gap-6 sm:grid-cols-2', featured ? 'lg:gap-8' : 'lg:gap-6']}>
        {entries.map((entry) => (
          <li class="row-span-5 grid grid-rows-subgrid gap-y-0">
            <CaseCard entry={entry} lang={lang} featured={featured} />
          </li>
        ))}
      </ul>
    </>
  ))
}
