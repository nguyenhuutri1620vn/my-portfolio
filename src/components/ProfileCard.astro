---
import { site } from '../data/site';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import Portrait from './Portrait.astro';

// Left column of both page heroes: portrait, then name, title and location.
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="flex flex-col items-center text-center lg:col-span-5">
  <Portrait alt={t('hero.avatarAlt')} />
  <p class="font-heading mt-3 text-2xl text-white sm:text-3xl">{site.name}</p>
  <p class="mt-1 text-base text-slate-200 sm:text-lg">
    {t('profile.title')} · {t('profile.experience')}
  </p>
  <p class="mt-0.5 text-sm text-slate-400 sm:text-base">{t('profile.location')}</p>
</div>
