---
import { site } from '../data/site';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="dark-band">
  <div class="container-page flex flex-wrap items-center justify-between gap-4 py-10 text-sm">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <a href="#top" class="link">{t('footer.backToTop')}</a>
  </div>
</footer>
