{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:todo": "grep -r '\\[TODO' src/ dist/ 2>/dev/null || echo 'No TODO found'",
    "check:names": "grep -Er 'BESTARION|Meperia|MSSS' src/ || echo 'No forbidden names'",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "astro": "^4.0.0",
    "@astrojs/mdx": "^3.0.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tailwindcss": "^3.0.0",
    "autoprefixer": "^10.0.0",
    "postcss": "^8.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  }
}
