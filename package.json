{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:todo": "node scripts/check-todo.mjs",
    "check:names": "node scripts/check-names.mjs",
    "verify": "npm run lint && npm run format:check && npm run check && npm run build && npm run check:todo && npm run check:names"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.0.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "astro": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/tailwind": "^5.1.5",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
